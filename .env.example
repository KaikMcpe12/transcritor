# Token de acesso do HuggingFace (grátis, https://huggingface.co/settings/tokens)
# OPCIONAL: necessário apenas para a diarização (identificação de falantes).
# Se rodar com --no-diarize, pode deixar em branco / remover.
# Antes de usar diarização, aceite os termos em:
#   https://huggingface.co/pyannote/segmentation-3.0
#   https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=hf_cole_seu_token_aqui

# Tamanho do modelo Whisper: tiny | base | small | medium | large-v3
# small  = ~500 MB, decente em PT-BR, ~0.5-0.8x realtime na CPU
# medium = ~1.5 GB, boa qualidade, ~1.5-2x realtime
# large-v3 = ~3 GB, topo de linha, ~3-5x realtime (lento em CPU)
WHISPER_MODEL=small

# Idioma do áudio (código ISO 639-1)
LANGUAGE=pt

# Batch size para transcrição (reduza se estourar RAM)
BATCH_SIZE=8
